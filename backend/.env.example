# LLM Provider (set ONE of the following pairs)
# Anthropic / Ark compatible
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://ark.cn-beijing.volces.com/api/plan

# OpenAI compatible
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# PostgreSQL persistence
POSTGRES_URI=postgres://postgres:postgres@localhost:5432/postgres?sslmode=disable

# Redis (used for rate limiting and caching)
REDIS_URI=redis://localhost:6379

# ---------------------------------------------------------------------------
# Authentication (leave empty to disable)
# ---------------------------------------------------------------------------
API_TOKEN=
API_KEY=
CORS_ORIGINS=http://localhost:5173,http://localhost:8123

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=json

# ---------------------------------------------------------------------------
# Rate Limiting
# ---------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
INPUT_MAX_LENGTH=4000
PII_DETECTION_ENABLED=true

# ---------------------------------------------------------------------------
# Cost Tracking
# ---------------------------------------------------------------------------
DAILY_TOKEN_BUDGET=0
COST_TRACKING_ENABLED=true

# ---------------------------------------------------------------------------
# Resilience
# ---------------------------------------------------------------------------
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3
DB_FALLBACK_ENABLED=false
